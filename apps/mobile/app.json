{
  "expo": {
    "name": "{nom}",
    "slug": "{slugExpo}",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "{schemaLiens}",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "{identifiantApple}",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/marque/Spotto.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004225",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/demarrage-exact.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA",
          "image": "./assets/marque/demarrage/image@3x.png",
          "imageWidth": 111,
          "dark": {
            "backgroundColor": "#141312",
            "image": "./assets/marque/demarrage/dark_image@3x.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour vous proposer dans Spotter votre dernière vidéo, comme vous l'avez demandé, ou vous laisser choisir une photo de vous pour l'essayage virtuel. {nom} ne lit que la vidéo la plus récente ou la photo choisie, et ne modifie jamais vos photos ni vos vidéos ; seules quelques images de la vidéo partent, quand vous appuyez sur « Lancer », et la photo, quand vous appuyez sur « Lancer l'essai ».",
          "cameraPermission": "Pour prendre en photo une pièce que vous voulez retrouver dans Spotter, votre photo de profil, ou une photo de vous pour l'essayage virtuel. La photo n'est pas enregistrée dans votre galerie ; elle ne part qu'au moment où vous appuyez sur « Lancer », « Valider » ou « Lancer l'essai ».",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-image",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Pour vous proposer dans Spotter votre dernière vidéo, comme vous l'avez demandé, ou vous laisser choisir une photo de vous pour l'essayage virtuel. {nom} ne lit que la vidéo la plus récente ou la photo choisie, et ne modifie jamais vos photos ni vos vidéos ; seules quelques images de la vidéo partent, quand vous appuyez sur « Lancer », et la photo, quand vous appuyez sur « Lancer l'essai ».",
          "savePhotosPermission": "Pour enregistrer dans vos photos l'image de votre essayage virtuel, quand vous appuyez sur « Enregistrer l'image ». {nom} ajoute seulement cette image, sans lire ni modifier vos autres photos.",
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": ["video"]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosAppGroupIdentifier": "{groupeApple}",
          "iosShareExtensionBundleIdentifier": "{identifiantExtensionPartage}",
          "disableAndroid": true
        }
      ],
      "./plugins/extension-partage.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "4512173801996368"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    }
  }
}
