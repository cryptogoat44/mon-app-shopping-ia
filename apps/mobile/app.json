{
  "expo": {
    "name": "{nom}",
    "slug": "{slugExpo}",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "{schemaLiens}",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "{identifiantApple}",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/marque/Spotto.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004225",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/demarrage-exact.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA",
          "image": "./assets/marque/demarrage/image@3x.png",
          "imageWidth": 111,
          "dark": {
            "backgroundColor": "#141312",
            "image": "./assets/marque/demarrage/dark_image@3x.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pour vous proposer dans Spotter votre dernière vidéo, comme vous l'avez demandé. {nom} ne lit que la plus récente et ne modifie jamais votre galerie ; seules quelques images en partent, quand vous appuyez sur « Lancer ».",
          "cameraPermission": "Pour prendre en photo une pièce que vous voulez retrouver dans Spotter, ou votre photo de profil. La photo n'est pas enregistrée dans votre galerie ; elle ne part qu'au moment où vous appuyez sur « Lancer » ou « Valider ».",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-image",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "Pour vous proposer dans Spotter votre dernière vidéo, comme vous l'avez demandé. {nom} ne lit que la plus récente et ne modifie jamais votre galerie ; seules quelques images en partent, quand vous appuyez sur « Lancer ».",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": ["video"]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosAppGroupIdentifier": "{groupeApple}",
          "iosShareExtensionBundleIdentifier": "{identifiantExtensionPartage}",
          "disableAndroid": true
        }
      ],
      "./plugins/extension-partage.js",
      "./plugins/lecteur-integre.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "4512173801996368"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    }
  }
}
