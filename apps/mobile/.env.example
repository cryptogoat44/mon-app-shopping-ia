# Même URL et clé "anon" que dans Supabase (Project Settings > API).
# La clé anon est publique par design : elle est visible dans l'app compilée,
# c'est la sécurité RLS côté base de données qui protège les données, pas ce secret.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme

# Adresse de votre backend local pendant le développement.
# Sur un téléphone physique (Expo Go), remplacez "localhost" par l'adresse IP
# locale de votre ordinateur (ex. http://192.168.1.24:3000), sinon le téléphone
# ne pourra pas joindre votre machine.
EXPO_PUBLIC_API_URL=http://localhost:3000
