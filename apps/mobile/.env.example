# Développement sur le Mac seulement. Les builds iPhone (EAS) lisent leurs
# réglages chez Expo, pas ici : voir apps/mobile/BUILD-IPHONE.md.

# Même URL que côté backend, et clé "publishable" (Project Settings > API Keys
# > Publishable key — anciennement appelée clé "anon").
# Cette clé est publique par design : elle est visible dans l'app compilée,
# c'est la sécurité RLS côté base de données qui protège les données, pas ce secret.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=changeme

# Adresse de votre backend local pendant le développement.
# Sur un téléphone physique (Expo Go), remplacez "localhost" par l'adresse IP
# locale de votre ordinateur (ex. http://192.168.1.24:3000), sinon le téléphone
# ne pourra pas joindre votre machine.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Facultatif — identité de l'éditeur, affichée dans les conditions
# d'utilisation, la politique de confidentialité, « Nous contacter » et la page
# « Aide et contact » (/aide). Le dépôt est public : ne jamais écrire ces
# valeurs ici, seulement dans apps/mobile/.env (local), chez Expo (app
# iPhone, profils preview et production) et chez Render (site). Absente,
# chaque valeur s'affiche « [À compléter : …] » ; sans adresse e-mail valable,
# « Nous contacter » est masqué et la page d'aide montre l'emplacement à compléter.
# EXPO_PUBLIC_PUBLISHER_NAME=
# EXPO_PUBLIC_PUBLISHER_STATUS=
# EXPO_PUBLIC_PUBLISHER_ADDRESS=
# EXPO_PUBLIC_PUBLISHER_EMAIL=
# EXPO_PUBLIC_PUBLISHER_PHONE=

# Facultatif — protection anti-robots (point 17, apps/mobile/ANTI-ROBOTS.md) :
# clé PUBLIQUE (« Site Key ») du widget Cloudflare Turnstile. Absente, aucun
# widget : connexion, inscription, « mot de passe oublié » et renvoi de
# l'e-mail partent sans vérification. Même valeur chez Render (site) et chez
# Expo (app iPhone). Pour essayer sur le Mac : la clé de test de Cloudflare
# 1x00000000000000000000AA (toujours acceptée). La « Secret Key » ne va QUE
# dans Supabase, jamais ici.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Facultatif — lecteurs officiels TikTok et Instagram (mission « liens vidéo »,
# src/lib/features.ts). Allumés par défaut ; seule la valeur exacte « false »
# coupe un lecteur dans le build (l'écran « Spottez cette vidéo » prend sa
# place). Les deux à « false » : le module natif de l'instantané n'est même
# pas relié à l'app (plugins/lecteur-integre.js). Le serveur peut encore
# couper un lecteur présent dans le build, jamais en allumer un absent.
# EXPO_PUBLIC_FEATURE_TIKTOK_PLAYER=false
# EXPO_PUBLIC_FEATURE_INSTAGRAM_PLAYER=false
