{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "tsx scripts/tests-ci.ts",
    "nettoyer-captures": "tsx scripts/nettoyer-captures.ts",
    "configurer-base-dev": "tsx scripts/configurer-base-dev.ts",
    "migrer-dev": "tsx scripts/migrer-dev.ts",
    "parcours-ecran": "tsx scripts/parcours-ecran/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@monapp/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "sharp": "0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.4",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
