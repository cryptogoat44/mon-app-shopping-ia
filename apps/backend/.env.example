# Réglages du serveur : copier ce fichier en apps/backend/.env (jamais
# envoyé sur GitHub) et remplir les valeurs. Liste complète des variables lues
# par src/env.ts ; aucune vraie clé ici. Mode d'emploi : SETUP.md (racine).

# URL du projet Supabase (Project Settings > General > Project ID)
# Format : https://<project-id>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé secrète (Project Settings > API Keys > Secret keys)
# Anciennement appelée "service_role". ATTENTION : cette clé contourne
# toutes les règles de sécurité (RLS). Elle ne doit JAMAIS être envoyée
# au mobile, uniquement utilisée ici, côté serveur.
SUPABASE_SERVICE_ROLE_KEY=changeme

# Clé API SerpApi (serpapi.com > Your Account > Your Private API Key)
# Utilisée pour la recherche visuelle Google Lens.
SERPAPI_KEY=changeme

# Facultatif — plafond GLOBAL des recherches SerpApi (lot 4 quater) : par jour
# (heure de Paris) et par cycle mensuel, qui commence le jour de renouvellement
# du quota chez SerpApi. Par défaut 25 et 225, pour un quota de 250 par mois
# renouvelé le 3. Compteur gardé dans la base (table serpapi_calls).
# SERPAPI_DAILY_CAP=25
# SERPAPI_MONTHLY_CAP=225
# SERPAPI_RENEWAL_DAY=3
# Part de chaque personne, par jour (8 par défaut).
# SERPAPI_USER_DAILY_CAP=8

# Facultatif — interrupteurs de la voie C (lot c), COUPÉS par défaut : seule
# la valeur exacte "true" en allume un, toute autre valeur le laisse coupé.
# VOIE_C_ENABLED : complément « boutiques » et « Que cherchez-vous ? » (après
# la migration 0028). VOIE_C_AI_ENABLED : l'étape IA (titres Lens seulement,
# jamais de photo), demande aussi ANTHROPIC_API_KEY. ANTHROPIC_PHOTO_ENABLED :
# envoi d'une photo à Anthropic, refusé tant qu'il est coupé.
# VOIE_C_ENABLED=false
# VOIE_C_AI_ENABLED=false
# ANTHROPIC_PHOTO_ENABLED=false

# Facultatif — notifications des nouveaux messages sur le téléphone (lot
# notifications, après la migration 0035), COUPÉES par défaut : seule la
# valeur exacte "true" les allume. Coupées : aucun appareil enregistré, rien
# d'envoyé, et l'app ne demande jamais l'autorisation.
# PUSH_ENABLED=false
# Facultatif — jeton d'accès d'Expo, seulement si la « sécurité renforcée des
# notifications » est activée dans le compte Expo (sinon, rien à mettre).
# EXPO_ACCESS_TOKEN=

# Facultatif — suivi des erreurs et ALERTES (Sentry, région UE). Sans DSN,
# rien n'est envoyé. Depuis le lot garde-fous, le serveur envoie aussi à
# Sentry des avertissements avec le tag « alerte » : disjoncteur ouvert
# (recherche en pause), plafond du jour ou du mois atteint (Spotter fermé à
# tous), plafond de l'IA atteint, échecs répétés d'un fournisseur, nouveau
# signalement et masquage automatique (chantier 3, aussi étiquetés
# « moderation » ; rien sur la personne qui signale). Voir ALERTES.md pour la
# règle à créer dans Sentry.
# En production, SENTRY_ENVIRONMENT doit valoir "production" (sinon les
# erreurs sont classées « development »).
# SENTRY_DSN=https://<clé>@<organisation>.ingest.de.sentry.io/<projet>
# SENTRY_ENVIRONMENT=production

# Facultatif — clé d'Anthropic (analyse automatique des vidéos ; IA de la
# voie C). Absente : ces fonctions se coupent proprement. Les limites de l'IA
# (10 analyses par personne, 300 en tout, par jour) sont comptées dans la base
# avec la migration 0029, en mémoire sans elle.
# ANTHROPIC_API_KEY=

# Facultatif — mise à jour obligatoire de l'app iPhone (lot « app iPhone
# prête »), COUPÉE par défaut. APP_MIN_IOS_BUILD : numéro de build minimal de
# l'app iPhone (celui qu'affichent EAS et App Store Connect, par exemple 12).
# Un iPhone avec un build plus ancien affiche « Mettez à jour Spotto » et le
# serveur lui répond 426 ; le site n'est jamais concerné. APP_STORE_URL : la
# fiche de Spotto sur l'App Store (https://apps.apple.com/…), pour le bouton
# de cet écran. Une valeur illisible vaut « aucun minimum » / « aucun bouton ».
# APP_MIN_IOS_BUILD=
# APP_STORE_URL=https://apps.apple.com/fr/app/spotto/id0000000000

# Facultatif — liens TikTok et Instagram (lot « nettoyage avant le premier
# build »), COUPÉS par défaut : seule la valeur exacte "true" les allume, toute
# autre valeur les laisse coupés. Coupés : un lien envoyé au serveur est ignoré
# (aucun appel à TikTok ni à Meta ; ni le lien ni l'adresse de l'image de
# couverture ne sont enregistrés), et une couverture enregistrée avant n'est
# jamais téléchargée : la personne importe sa propre capture d'écran, comme
# dans l'app aujourd'hui. À n'allumer qu'avec l'accord écrit de la plateforme,
# à la main, dans Render (jamais par un outil).
# LINK_PREVIEW_ENABLED=false

# Facultatif — jeton d'accès d'une app Meta enregistrée (developers.facebook.com),
# nécessaire uniquement pour activer l'oEmbed officiel Instagram.
# Sans lui, Instagram passe directement par le repli "capture manuelle".
# Ne sert que si LINK_PREVIEW_ENABLED est allumé.
# META_OEMBED_ACCESS_TOKEN=

# Facultatif — essayage virtuel photo (lot « essayage virtuel », migration
# 0042), ÉTEINT par défaut. Interrupteur double : TRYON_ENABLED ci-dessous ET
# le drapeau feature_flags.tryon de la base (pnpm --filter backend tryon:flag).
# Seule la valeur exacte "true" allume TRYON_ENABLED. Un réglage invalide
# plus bas laisse l'essayage éteint, avec un avertissement dans le journal
# (jamais la clé), sans arrêter le serveur. À n'allumer qu'après l'accord de
# l'avocat, à la main, dans Render (jamais par un outil).
TRYON_ENABLED=false
# Fournisseur de l'essayage : « fake » (faux essai, sans aucun appel réseau :
# la photo revient avec un bandeau « TEST – FAUX ESSAI » ; refusé en
# production) ou « fashn » (FASHN, modèle tryon-v1.6, payant).
TRYON_PROVIDER=fake
# Clé secrète de FASHN (fashn.ai), serveur seulement : jamais dans l'app ni
# le site, jamais dans le dépôt. Vide : absente. Lue seulement si
# TRYON_ENABLED vaut "true" avec TRYON_PROVIDER=fashn.
FASHN_API_KEY=
# Adresse de l'API de FASHN (https obligatoire, sans « / » final).
FASHN_API_BASE_URL=https://api.fashn.ai/v1
# Essais gratuits par membre et par mois civil (fuseau TRYON_TIMEZONE), non
# reportables ; un essai n'est décompté que s'il réussit.
TRYON_FREE_PER_MONTH=5
# Essais offerts par achat confirmé (utilisés après les gratuits, ceux qui
# expirent le plus tôt d'abord)…
TRYON_BONUS_PER_PURCHASE=5
# … et leur durée de validité, en jours.
TRYON_BONUS_VALIDITY_DAYS=365
# Seules les pièces avec un lien d'achat valide peuvent être essayées
# ("true" ou "false").
TRYON_REQUIRE_BUY_LINK=true
# Budget du mois chez FASHN, en dollars : atteint, plus aucun essai jusqu'au
# mois suivant (« Les essais sont momentanément indisponibles »).
TRYON_MONTHLY_BUDGET_USD=100
# Seuil d'alerte du budget (0.8 = 80 %, point décimal) : noté dans la table
# tryon_alerts et dans le journal.
TRYON_ALERT_THRESHOLD=0.8
# Prix d'un crédit FASHN, en dollars (un essai tryon-v1.6 = 1 crédit).
TRYON_PRICE_PER_CREDIT_USD=0.075
# Solde de crédits FASHN en dessous duquel aucun essai ne part (refus et alerte).
TRYON_MIN_FASHN_CREDITS=20
# Fuseau horaire du mois civil des essais gratuits (nom IANA).
TRYON_TIMEZONE=Europe/Paris

# Facultatif côté serveur — jamais utilisée à l'exécution, seulement par les
# tests (pnpm test) pour se connecter en tant qu'utilisateur de test.
# Clé publique (Project Settings > API Keys > anon/public), sans risque.
SUPABASE_ANON_KEY=changeme

# Port local du serveur
PORT=3000

# Rempli par Render lui-même, jamais à la main — version servie (lot « filets
# de sécurité ») : le commit construit, renvoyé par /health en 7 caractères
# (« "version": "a0212c1" »). Nom de la variable à vérifier dans la
# documentation de Render. Absente (sur un ordinateur) : « "version": null ».
# RENDER_GIT_COMMIT=

# Ne jamais régler NODE_ENV=test ailleurs que dans les tests : cette valeur
# coupe les limites par personne, le disjoncteur et les plafonds de l'IA.
