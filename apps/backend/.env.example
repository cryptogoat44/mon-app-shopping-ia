# URL du projet Supabase (Project Settings > General > Project ID)
# Format : https://<project-id>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé secrète (Project Settings > API Keys > Secret keys)
# Anciennement appelée "service_role". ATTENTION : cette clé contourne
# toutes les règles de sécurité (RLS). Elle ne doit JAMAIS être envoyée
# au mobile, uniquement utilisée ici, côté serveur.
SUPABASE_SERVICE_ROLE_KEY=changeme

# Port local du serveur
PORT=3000
