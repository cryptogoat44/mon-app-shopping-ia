# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé "service_role" (Project Settings > API > service_role secret)
# ATTENTION : cette clé contourne toutes les règles de sécurité (RLS).
# Elle ne doit JAMAIS être envoyée au mobile, uniquement utilisée ici, côté serveur.
SUPABASE_SERVICE_ROLE_KEY=changeme

# Port local du serveur
PORT=3000
