# URL du projet Supabase (Project Settings > General > Project ID)
# Format : https://<project-id>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé secrète (Project Settings > API Keys > Secret keys)
# Anciennement appelée "service_role". ATTENTION : cette clé contourne
# toutes les règles de sécurité (RLS). Elle ne doit JAMAIS être envoyée
# au mobile, uniquement utilisée ici, côté serveur.
SUPABASE_SERVICE_ROLE_KEY=changeme

# Clé API SerpApi (serpapi.com > Your Account > Your Private API Key)
# Utilisée pour la recherche visuelle Google Lens.
SERPAPI_KEY=changeme

# Facultatif — plafond GLOBAL des recherches SerpApi (lot 4 quater) : par jour
# (heure de Paris) et sur 31 jours glissants. Par défaut 25 et 225, pour un
# quota de 250 par mois. Compteur gardé dans la base (table serpapi_calls).
# SERPAPI_DAILY_CAP=25
# SERPAPI_MONTHLY_CAP=225
# Part de chaque personne, par jour (8 par défaut).
# SERPAPI_USER_DAILY_CAP=8

# Facultatif — jeton d'accès d'une app Meta enregistrée (developers.facebook.com),
# nécessaire uniquement pour activer l'oEmbed officiel Instagram.
# Sans lui, Instagram passe directement par le repli "capture manuelle".
# META_OEMBED_ACCESS_TOKEN=

# Facultatif côté serveur — jamais utilisée à l'exécution, seulement par les
# tests (pnpm test) pour se connecter en tant qu'utilisateur de test.
# Clé publique (Project Settings > API Keys > anon/public), sans risque.
SUPABASE_ANON_KEY=changeme

# Port local du serveur
PORT=3000
